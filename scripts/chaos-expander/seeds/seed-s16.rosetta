//== header
namespace chaos.s16.seed
version "0.0.0"
//== helper C16Held
type C16Held: <"Self-contained helper - relocated by the import axis.">
    h string (1..1)
//== element C16Opts
type C16Alpha: <"Choice option 1 - its NAME is the shadowing battery's subject.">
    a string (1..1)
type C16Beta: <"Choice option 2.">
    b string (1..1)
choice C16Pick: <"The choice whose bare option names the rivals collide with.">
    C16Alpha
    C16Beta
//== element C16Use
func C16Grab: <"Resolves C16Alpha at a type-guard switch seat - the resolution probe.">
    inputs:
        p C16Pick (1..1)
    output:
        s string (1..1)
    set s:
        p switch
            C16Alpha then "was-alpha",
            C16Beta then "was-beta",
            default "neither"
type C16Slot: <"Resolves C16Alpha at an attribute type seat.">
    firstPick C16Alpha (0..1)
    held C16Held (0..1)
//== collision C16Alpha kind=type
type C16Alpha: <"RIVAL - a same-named global type in an imported namespace (the a2/P2 class).">
    rivalMark string (0..1)
//== collision C16Pick kind=choice
type C16RivalOpt: <"The rival choice's own option type.">
    r string (0..1)
choice C16Pick: <"RIVAL - a same-named global choice in an imported namespace (the P3 class).">
    C16RivalOpt
//== collision C16Meta kind=meta
metaType C16Alpha string
