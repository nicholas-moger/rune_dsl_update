//== header
namespace chaos.s15.seed
version "0.0.0"
//== helper C15Aux
type C15Aux: <"Self-contained helper - relocated by the import axis.">
    ax string (1..1)
//== element C15Basic
basicType c15token <"A model-declared basic type - normally builtin-only; ORACLE-ARBITRATED (charter S15).">
basicType c15scaled(c15digits int) <"A parameterised model-declared basic type.">
//== element C15Record
recordType c15span
{
	lo int
	hi int
}
//== element C15Lib
library function C15Half(x number) number
library function C15Today() date
//== element C15Use
type C15Carrier: <"Uses the model-declared builtins beside real ones.">
    tok c15token (0..1)
    span c15span (0..1)
    aux C15Aux (0..1)
