#!/usr/bin/env bash
# Smoke test — argument validation + integration test for the
# destructive cp -r + atomic-rename workflow.
set -euo pipefail

# Resolve REPO_ROOT regardless of cwd (Copilot R14 F10 — convention
# alignment with scripts/ci/*.sh.test). Without this, the test fails
# when invoked from any directory other than the repository root.
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

SCRIPT="scripts/legacy-vs-fork/snapshot-goldens.sh"
[[ -f "$SCRIPT" ]] || { echo "FAIL: $SCRIPT missing"; exit 1; }

assert_reject() {
    local arg="$1" label="$2"
    if "$SCRIPT" "$arg" >/dev/null 2>&1; then
        echo "FAIL: $SCRIPT should reject $label input: '$arg'"
        exit 1
    fi
}

# Case 1: path traversal
assert_reject ".."          "path traversal '..'"
assert_reject "../etc"      "path traversal prefix"
assert_reject "cdm/../etc"  "embedded path traversal"

# Case 2: absolute path
assert_reject "/etc/passwd" "absolute path"

# Case 3: regex bypass (Class A R4) — would have matched cells.txt entries
# pre-fix because validation used `grep -qE` against user input.
assert_reject ".*"          "regex bypass '.*'"
assert_reject "drr/.*"      "regex bypass 'drr/.*'"
assert_reject "cdm/.*"      "regex bypass 'cdm/.*'"

# Case 4: unknown cell (validates literal match against cells.txt)
assert_reject "fake/cell-99" "unknown cell"
assert_reject "cdm/cdm-6.15.0extra" "near-miss cell name"

# Case 5: multi-arg invocation rejected (R5 Class A) — exit 2 specifically
if "$SCRIPT" cdm/cdm-6.15.0 extra-arg >/dev/null 2>&1; then
    echo "FAIL: multi-arg should be rejected"
    exit 1
fi
rc=$?
if [ "$rc" -ne 2 ]; then
    set +e
    "$SCRIPT" cdm/cdm-6.15.0 extra-arg >/dev/null 2>&1
    rc=$?
    set -e
    if [ "$rc" -ne 2 ]; then
        echo "FAIL: multi-arg rejection should exit 2, got $rc"
        exit 1
    fi
fi

# Integration test (Copilot R14 F8) — exercise the destructive cp -r +
# atomic-rename + marker-clear workflow against a synthetic tmp tree
# instead of the real test-corpus. Verifies (1) java/ subtree is
# snapshotted, (2) snapshot dir exists post-run, (3) any prior regen
# marker is cleared, (4) idempotent rerun reports ALREADY without
# re-copying.
TMP_HARNESS="$(mktemp -d -t snapshot-it.XXXXXX)"
cleanup_integration() {
    rm -rf "$TMP_HARNESS"
}
trap cleanup_integration EXIT

# Synthetic corpus: one cell with pom.xml + a generated/java/ tree
# holding a known fingerprint file. cells.txt with a matching row.
CELL="testcorpus/synth-1.0.0"
SYNTH_CELL_DIR="$TMP_HARNESS/corpus/$CELL"
mkdir -p "$SYNTH_CELL_DIR/rosetta-source/src/generated/java/com/example"
echo "synth-pom" > "$SYNTH_CELL_DIR/pom.xml"
echo "public class Stub {}" > "$SYNTH_CELL_DIR/rosetta-source/src/generated/java/com/example/Stub.java"

SYNTH_CELLS="$TMP_HARNESS/cells.txt"
printf '%s|1.0.0\n' "$CELL" > "$SYNTH_CELLS"

SYNTH_LOG="$TMP_HARNESS/logs"
mkdir -p "$SYNTH_LOG"

# Plant a stale marker to verify it gets cleared on successful snapshot.
MARKER="$SYNTH_LOG/regen-$(echo "$CELL" | tr '/' '-').done"
echo "stale" > "$MARKER"

# Run the script with env overrides redirecting to the synth tree.
TEST_CORPUS="$TMP_HARNESS/corpus" \
CELLS_FILE="$SYNTH_CELLS" \
LOG_DIR="$SYNTH_LOG" \
    "$SCRIPT" "$CELL" >/dev/null 2>&1

# Assertion 1: snapshot dir exists
SNAP="$SYNTH_CELL_DIR/rosetta-source/src/generated-as-cloned"
[ -d "$SNAP" ] || { echo "FAIL: snapshot dir not created at $SNAP"; exit 1; }

# Assertion 2: java/ subtree copied with fingerprint file
[ -f "$SNAP/java/com/example/Stub.java" ] || { echo "FAIL: snapshot missing Stub.java"; exit 1; }

# Assertion 3: marker cleared by successful snapshot
[ ! -f "$MARKER" ] || { echo "FAIL: stale marker not cleared post-snapshot"; exit 1; }

# Assertion 4: idempotent rerun reports ALREADY (exits 0) without re-copying.
# Touch a file in the snapshot to detect re-copy — a re-copy would overwrite it.
SENTINEL="$SNAP/.idempotency-sentinel"
echo "sentinel" > "$SENTINEL"
TEST_CORPUS="$TMP_HARNESS/corpus" \
CELLS_FILE="$SYNTH_CELLS" \
LOG_DIR="$SYNTH_LOG" \
    "$SCRIPT" "$CELL" >/dev/null 2>&1
[ -f "$SENTINEL" ] || { echo "FAIL: idempotent rerun re-copied (sentinel destroyed)"; exit 1; }

# ISO20022 sub-case (Copilot R15 F2) — exercise the path-resolution
# branch for iso20022/* cells which use rosetta-source/target/classes/
# generated instead of src/generated. Without this, the safety-
# critical destructive workflow against the 3 iso20022/* cells in
# cells.txt is never tested.
ISO_CELL="iso20022/synth-1.0.0"
ISO_CELL_DIR="$TMP_HARNESS/corpus/$ISO_CELL"
mkdir -p "$ISO_CELL_DIR/rosetta-source/target/classes/generated/java/com/example/iso"
echo "iso-pom" > "$ISO_CELL_DIR/pom.xml"
echo "public class IsoStub {}" > "$ISO_CELL_DIR/rosetta-source/target/classes/generated/java/com/example/iso/IsoStub.java"
printf '%s|1.0.0\n%s|1.0.0\n' "$CELL" "$ISO_CELL" > "$SYNTH_CELLS"
TEST_CORPUS="$TMP_HARNESS/corpus" \
CELLS_FILE="$SYNTH_CELLS" \
LOG_DIR="$SYNTH_LOG" \
    "$SCRIPT" "$ISO_CELL" >/dev/null 2>&1
ISO_SNAP="$ISO_CELL_DIR/rosetta-source/target/classes/generated-as-cloned"
[ -d "$ISO_SNAP" ] || { echo "FAIL: iso20022 snapshot dir not created at $ISO_SNAP"; exit 1; }
[ -f "$ISO_SNAP/java/com/example/iso/IsoStub.java" ] || { echo "FAIL: iso20022 snapshot missing IsoStub.java"; exit 1; }

echo "PASS: snapshot-goldens validation + integration (+ iso20022)"
