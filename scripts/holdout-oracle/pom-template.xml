<?xml version="1.0" encoding="UTF-8"?>
<!-- W42 sweep leg B slice 2 — the hold-out ORACLE scaffold pom (PR #410).

     Instantiated per hold-out group by run-holdout-oracle.sh (two fixed
     placeholders: @GROUP@ = the group name; @ROSETTA_CONFIG@ = either
     nothing or a <rosettaConfig> element pointing at the group's own
     rosetta-config.yml — PR #422). Runs the RELEASED
     com.regnosys.rosetta:rosetta-maven-plugin:9.83.0 from ~/.m2 over the
     group's fixture models to pin byte-goldens.

     THE ORACLE LAW: the released 9.83.0 plugin JARs are the oracle — NEVER
     the vendored rune-dsl/ source (it is 0.0.0.main-SNAPSHOT, post-9.83;
     building it as the oracle would silently corrupt the comparison).

     The configuration mirrors the CDM 6.20.6 rosetta-source pom's generate
     execution (corpus-baseline-9.83/cdm/cdm-6.20.6/rosetta-source/pom.xml,
     the canonical 9.83.0-era consumer) with three deliberate deltas:
     - sourceRoots points at the raw fixture copies (NO Maven resource
       filtering — declared model versions must pass through verbatim;
       unversioned models resolve to upstream's EMF default "0.0.0",
       RosettaModelImpl.VERSION_EDEFAULT, oracle-probe-verified).
     - classPathLookupFilter is OMITTED: the CDM regex matched 0 of the 22
       classpath entries on this box (probe target-410-oracleprobe1.log;
       builtins then fail to resolve and the build fails loudly), while the
       same regex matches the rune-runtime jar path in isolation — the
       mismatch is inside the mojo's entry handling. Without the filter the
       plugin investigates every classpath entry; the only model-bearing jar
       on this classpath is org.finos.rune:rune-runtime, so the lookup
       result — and the generated bytes — are identical.
     - no rosettaConfig BY DEFAULT: the plugin's default configuration
       generates every namespace in the workspace, which is exactly the
       hold-out contract (CDM's yml only narrows namespaces; fixtures span
       many). A group MAY opt in by carrying its own rosetta-config.yml
       (PR #422: func-extends-valid enables upstream's experimental `scopes`
       feature, which `func ... extends` requires); the driver then fills
       @ROSETTA_CONFIG@ with the <rosettaConfig> element. Opt-in configs
       keep the default model name and declare NO generators section, so
       generation behaviour is untouched — only validation gating changes.

     org.finos.rune:rune-runtime:9.83.0 supplies the builtin models
     (annotations.rosetta / basictypes.rosetta) via classpath lookup; its
     model files are line-ending-identical to the fork's
     test-corpus/rune-dsl-builtins copies (probe-verified). -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.finos.rune.holdout</groupId>
    <artifactId>holdout-oracle-@GROUP@</artifactId>
    <!-- The scaffold's own version must NOT leak into generation (no Maven
         resource filtering is configured, and the probe confirmed emitted
         files carry model-declared versions / the 0.0.0 default only). The
         deliberately loud value below would be instantly recognisable in
         any golden if that invariant ever broke. -->
    <version>0.0.0.holdout-oracle</version>
    <packaging>jar</packaging>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.finos.rune</groupId>
            <artifactId>rune-runtime</artifactId>
            <version>9.83.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>com.regnosys.rosetta</groupId>
                <artifactId>rosetta-maven-plugin</artifactId>
                <version>9.83.0</version>
                <executions>
                    <execution>
                        <id>generate-rosetta</id>
                        <phase>generate-sources</phase>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <sourceRoots>
                                <sourceRoot>${project.basedir}/model</sourceRoot>
                            </sourceRoots>
                            <incrementalXtextBuild>false</incrementalXtextBuild>
                            @ROSETTA_CONFIG@
                            <languages>
                                <language>
                                    <setup>com.regnosys.rosetta.RosettaStandaloneSetup</setup>
                                    <outputConfigurations>
                                        <outputConfiguration>
                                            <outputDirectory>src/generated/java/</outputDirectory>
                                        </outputConfiguration>
                                    </outputConfigurations>
                                </language>
                            </languages>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
