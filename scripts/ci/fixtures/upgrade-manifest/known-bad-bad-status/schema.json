{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rune-dsl-review:upgrade-manifest:schema",
  "title": "rune-dsl-plus upgrade manifest index",
  "type": "object",
  "required": ["fork_baseline_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "fork_baseline_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id", "subject", "since_fork_version", "since_pr_at_spec",
        "status", "migration_depth", "future_deprecation_risk", "doc_path"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^U\\d{3}$" },
        "subject": { "type": "string", "minLength": 1 },
        "since_fork_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "since_pr_at_spec": { "type": "integer", "minimum": 1 },
        "since_pr_actual": { "type": ["integer", "null"], "minimum": 1 },
        "since_sha": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          ]
        },
        "status": { "enum": ["Available", "Deprecated", "Removed"] },
        "migration_depth": {
          "type": "string",
          "pattern": "^(None|Optional|Required-by-v\\d+\\.\\d+(\\.\\d+)?)$"
        },
        "removal_target": { "type": ["string", "null"] },
        "future_deprecation_risk": { "enum": ["low", "medium", "high"] },
        "related_d_entries": {
          "type": "array",
          "items": { "type": "string", "pattern": "^D\\d+$" }
        },
        "related_audit_hooks": {
          "type": "array",
          "items": { "type": "string", "pattern": "^H\\d+$" }
        },
        "related_parity_constraints": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#\\d+$" }
        },
        "doc_path": { "type": "string", "pattern": "^U\\d{3}-[a-z0-9-]+\\.md$" }
      }
    }
  }
}
