<\t><\t>
<\t><\t>// RosettaFunction dependencies
<\t><\t>//
<v.variantModel.dependencies:{dep | <\t><\t>@Inject protected <dep.typeName> <dep.fieldName>;}; separator="\n">
<endif>
<elseif(v.variantModel.hasObjectValidator)>
<\t><\t>
<\t><\t>@Inject protected ModelObjectValidator objectValidator;
<if(v.variantModel.dependencies)>
<\t><\t>
<\t><\t>// RosettaFunction dependencies
