<v.variantModel.dependencies:{dep | <\t><\t>@Inject protected <dep.typeName> <dep.fieldName>;}; separator="\n">
<endif>
<\t>
<\t><\t>/**
<v.variantModel.javadocParams:{p | <\t><\t>* <p>
}><\t><\t>*/
<\t><\t>public <evaluateReturnType(v.variantModel)> evaluate(<v.variantModel.inputs:{inp | <inputParam(inp)>}; separator=", ">) {
<if(v.variantModel.preConditions)>
<\t><\t><\t>// pre-conditions
<v.variantModel.preConditions:{c | <\t><\t><\t>conditionValidator.validate(() -> <c.compiledExpression>,
<\t><\t><\t><\t>"<c.definition>");
}>
<\t><\t><\t>
<endif>
<if(v.variantModel.outputNeedsBuilder)>
<if(v.variantModel.outputIsMulti)>
<\t><\t><\t>List\<<v.variantModel.output.typeName>.<v.variantModel.output.builderTypeName>\> <v.variantModel.output.builderName> = doEvaluate(<v.variantModel.inputs:{inp | <inp.name>}; separator=", ">);
<\t><\t><\t>
<\t><\t><\t>final List\<? extends <v.variantModel.output.typeName>\> <v.variantModel.output.name>;
<\t><\t><\t>if (<v.variantModel.output.builderName> == null) {
<\t><\t><\t><\t><v.variantModel.output.name> = null;
<\t><\t><\t>} else {
<\t><\t><\t><\t><v.variantModel.output.name> = <v.variantModel.output.builderName>.stream().map(<v.variantModel.output.typeName>::build).collect(Collectors.toList());
<\t><\t><\t><\t>objectValidator.validate(<v.variantModel.output.typeName>.class, <v.variantModel.output.name>);
<\t><\t><\t>}
<else>
<\t><\t><\t><v.variantModel.output.typeName>.<v.variantModel.output.builderTypeName> <v.variantModel.output.builderName> = doEvaluate(<v.variantModel.inputs:{inp | <inp.name>}; separator=", ">);
<\t><\t><\t>
<\t><\t><\t>final <v.variantModel.output.typeName> <v.variantModel.output.name>;
<\t><\t><\t>if (<v.variantModel.output.builderName> == null) {
<\t><\t><\t><\t><v.variantModel.output.name> = null;
<\t><\t><\t>} else {
<\t><\t><\t><\t><v.variantModel.output.name> = <v.variantModel.output.builderName>.build();
<\t><\t><\t><\t>objectValidator.validate(<v.variantModel.output.typeName>.class, <v.variantModel.output.name>);
<\t><\t><\t>}
<endif>
<else>
<\t><\t><\t><evaluateReturnType(v.variantModel)> <v.variantModel.output.name> = doEvaluate(<v.variantModel.inputs:{inp | <inp.name>}; separator=", ">);
<endif>
<\t><\t><\t>
<if(v.variantModel.postConditions)>
<\t><\t><\t>// post-conditions
<v.variantModel.postConditions:{c | <\t><\t><\t>conditionValidator.validate(() -> <c.compiledExpression>,
<\t><\t><\t><\t>"<c.definition>");
}>
<\t><\t><\t>
<endif>
<\t><\t><\t>return <v.variantModel.output.name>;
<\t><\t>}
<\t>
<\t><\t>protected abstract <doEvaluateReturnType(v.variantModel)> doEvaluate(<v.variantModel.inputs:{inp | <inputParam(inp)>}; separator=", ">);
<v.variantModel.aliases:{a |
<\t>
<\t><\t>protected abstract <a.returnType> <a.name>(<v.variantModel.inputs:{inp | <inputParam(inp)>}; separator=", ">);
}><\\>
<\t>
<\t><\t>public static class <v.variantClassName>Default extends <m.className>.<v.variantClassName> {
<\t><\t><\t>@Override
<\t><\t><\t>protected <doEvaluateReturnType(v.variantModel)> doEvaluate(<v.variantModel.inputs:{inp | <inputParam(inp)>}; separator=", ">) {
<v.variantModel.inputs:{inp | <if(inp.isMulti)>
<\t><\t><\t><\t>if (<inp.name> == null) {
<\t><\t><\t><\t><\t><inp.name> = Collections.emptyList();
<\t><\t><\t><\t>\}
<endif>}>
<if(v.variantModel.outputIsMulti)>
<if(v.variantModel.outputNeedsBuilder)>
<\t><\t><\t><\t>List\<<v.variantModel.output.typeName>.<v.variantModel.output.builderTypeName>\> <v.variantModel.output.name> = new ArrayList\<\>();
<else>
<\t><\t><\t><\t>List\<<v.variantModel.output.typeName>\> <v.variantModel.output.name> = new ArrayList\<\>();
<endif>
<elseif(v.variantModel.outputNeedsBuilder)>
<\t><\t><\t><\t><v.variantModel.output.typeName>.<v.variantModel.output.builderTypeName> <v.variantModel.output.name> = <v.variantModel.output.typeName>.builder();
<else>
<\t><\t><\t><\t><v.variantModel.output.typeName> <v.variantModel.output.name> = null;
<endif>
<\t><\t><\t><\t>return assignOutput(<v.variantModel.output.name>, <v.variantModel.inputs:{inp | <inp.name>}; separator=", ">);
<\t><\t><\t>}
<\t><\t><\t>
<\t><\t><\t>protected <doEvaluateReturnType(v.variantModel)> assignOutput(<doEvaluateReturnType(v.variantModel)> <v.variantModel.output.name>, <v.variantModel.inputs:{inp | <inputParam(inp)>}; separator=", ">) {
<v.variantModel.operations:{op | <\t><\t><\t><\t><op.compiledStatement>
}; separator="\t\t\t\t\n"><if(v.variantModel.operations)><\t><\t><\t><\t>
<endif>
<if(v.variantModel.outputNeedsBuilder)>
<if(v.variantModel.outputIsMulti)>
<\t><\t><\t><\t>return Optional.ofNullable(<v.variantModel.output.name>)
<\t><\t><\t><\t><\t>.map(o -> o.stream().map(i -> i.prune()).collect(Collectors.toList()))
<\t><\t><\t><\t><\t>.orElse(null);
<else>
<\t><\t><\t><\t>return Optional.ofNullable(<v.variantModel.output.name>)
<\t><\t><\t><\t><\t>.map(o -> o.prune())
<\t><\t><\t><\t><\t>.orElse(null);
<endif>
<else>
<\t><\t><\t><\t>return <v.variantModel.output.name>;
<endif>
<\t><\t><\t>}
<v.variantModel.aliases:{a |
