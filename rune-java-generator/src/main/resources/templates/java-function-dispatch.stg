delimiters "<", ">"

inputParam(inp) ::= <%
<if(inp.isMulti)><if(inp.isRosettaModelType)>List\<? extends <inp.typeName>\> <inp.name><else>List\<<inp.typeName>\> <inp.name><endif><else><inp.typeName> <inp.name><endif>
%>

evaluateReturnType(m) ::= <%
<if(m.outputIsMulti)><if(m.outputNeedsBuilder)>List\<? extends <m.output.typeName>\><else>List\<<m.output.typeName>\><endif><else><m.output.typeName><endif>
%>

doEvaluateReturnType(m) ::= <%
<if(m.outputIsMulti)><if(m.outputNeedsBuilder)>List\<<m.output.typeName>.<m.output.builderTypeName>\><else>List\<<m.output.typeName>\><endif><else><if(m.outputNeedsBuilder)><m.output.typeName>.<m.output.builderTypeName><else><m.output.typeName><endif><endif>
%>

dispatchFile(m) ::= <<
package <m.packageName>;

<m.imports:{imp | import <imp>;
}>
<if(m.staticImports)>
<m.staticImports:{imp | import static <imp>;
}>
<else>

<endif>
<if(m.definition)>
/**
<" ">* <m.definition>
<" ">* @version <m.version>
<" ">*/
<else>
/**
<" ">* @version <m.version>
<" ">*/
<endif>
public class <m.className> implements RosettaFunction {
<\t>
<m.dispatchVariants:{v | <\t>@Inject protected <m.className>.<v.variantClassName> <v.fieldName>;}; separator="\n">
<\t>
<\t>public <evaluateReturnType(m)> evaluate(<m.inputs:{inp | <inputParam(inp)>}; separator=", ">) {
<\t><\t>switch (<m.dispatchParamName>) {
<m.dispatchVariants:{v | <\t><\t><\t>case <v.enumValue>:
<\t><\t><\t><\t>return <v.fieldName>.evaluate(<m.inputs:{inp | <inp.name>}; separator=", ">);}; separator="\n">
<\t><\t><\t>default:
<\t><\t><\t><\t>throw new IllegalArgumentException("Enum value not implemented: " + <m.dispatchParamName>);
<\t><\t>}
<\t>}
<\t>
<m.dispatchVariants:{v | <variantClass(v, m)>
}>}

>>

variantClass(v, m) ::= <<
<\t>@ImplementedBy(<m.className>.<v.variantClassName>.<v.variantClassName>Default.class)
<\t>public static abstract class <v.variantClassName> implements RosettaFunction {
<if(v.variantModel.hasConditions)>
<\t><\t>
