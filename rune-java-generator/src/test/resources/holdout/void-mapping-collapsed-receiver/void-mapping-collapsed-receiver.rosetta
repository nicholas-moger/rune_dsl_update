namespace holdout.voidcollapse
version "0.0.0"

// v3.2 seat 9 round 3 (the code-quality review's MF-1 / the spec review's SF-6): the operation seat's general path
// with a Void value that MINTS a hoist name while it is compiled - a conditional RECEIVER collapses to an
// `ifThenElseResult` local before the feature hop, and the hop's type is Void. Round 2's law ("a discarded builder
// consumes NO name") was measured on a BARE Void conditional under `exists`, which upstream coerces before any
// collapse. Here the collapse precedes the coercion: does upstream's discarded receiver still ADVANCE the
// `ifThenElseResult` counter (so a LATER conditional is `ifThenElseResult1`), and does the fork agree? The two-op
// function is the witness - the second op's condition is a string COMPARISON (corpus-exercised, byte-identical) so the
// ONLY variable the fixture measures is the counter index of the KEPT conditional.

basicType etoken <"A model-declared basic type - a Void-typed value in the generated Java.">

type Carrier: <"A model type carrying a Void-typed attribute.">
    tok etoken (0..1)

type Pair: <"An output carrying a Void-typed attribute beside a plain one.">
    v etoken (0..1)
    s string (0..1)

func CollapsedReceiver: <"A Void feature hop over a conditional receiver, SET into a Void output - the general path, one op.">
    inputs:
        flag boolean (1..1)
        c1 Carrier (0..1)
        c2 Carrier (0..1)
    output:
        r etoken (0..1)
    set r: (if flag then c1 else c2) -> tok

func CollapsedReceiverThenConditional: <"The same hop SET into a segment leaf, FOLLOWED by a plain conditional (a string comparison condition) into the sibling leaf - the counter-advance witness.">
    inputs:
        flag boolean (1..1)
        c1 Carrier (0..1)
        c2 Carrier (0..1)
        a string (0..1)
        b string (0..1)
    output:
        p Pair (1..1)
    set p -> v: (if flag then c1 else c2) -> tok
    set p -> s: if a = b then "x" else "y"
