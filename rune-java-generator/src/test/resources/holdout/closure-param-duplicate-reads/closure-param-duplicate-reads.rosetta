namespace holdout.closureparamduplicatereads
version "0.0.0"

type Item: <"The M12 carrier's element (v3.2 seat 12, D52 H1 - the round-1 code-quality review's MF-1): a number-valued item reduced over, the reduce body READING the shared-name parameter through two further seats - a navigation off the parameter and a call taking the parameter as an argument.">
    v number (1..1)

func Merge: <"A two-input function the call-read shapes pass the reduce parameter to.">
    inputs:
        x Item (1..1)
        y Item (1..1)
    output:
        z Item (1..1)
    set z: x

func MergeV: <"A function taking an item and a number - the nav-read shapes pass the reduce parameter as the item and a navigation off it as the number.">
    inputs:
        x Item (1..1)
        n number (1..1)
    output:
        z Item (1..1)
    set z: x

func ReduceDupNavRead: <"THE NAV-READ SHAPE: the shared-name pair `reduce a, a` whose body NAVIGATES off the parameter (`a -> v`, passed beside the parameter itself to a function) - the closure-parameter RECEIVER seat, in a body with no conditional (the conditional whole-body form is a declared residual of its own). The released plugin's rendering of the pair and of the receiver is the golden.">
    inputs:
        items Item (0..*)
    output:
        pick Item (1..1)
    set pick: items reduce a, a [ MergeV(a, a -> v) ]

func ReduceDupCallRead: <"THE CALL-READ SHAPE: the shared-name pair whose body passes the parameter to a function (`Merge(a, a)`) - the evaluate-argument seat. The released plugin's rendering of the pair and of the arguments is the golden.">
    inputs:
        items Item (0..*)
    output:
        merged Item (1..1)
    set merged: items reduce a, a [ Merge(a, a) ]

func ReduceDistinctNavRead: <"THE CONTROL for the nav-read seat: two DISTINCT parameters navigated off - a fix that numbers or renames every receiver must leave this one as the plugin renders it.">
    inputs:
        items Item (0..*)
    output:
        pick Item (1..1)
    set pick: items reduce a, b [ MergeV(a, b -> v) ]

func ReduceDistinctCallRead: <"THE CONTROL for the call-read seat: two DISTINCT parameters passed to the function - the evaluate-argument seat at an unnumbered pair, as the plugin renders it.">
    inputs:
        items Item (0..*)
    output:
        merged Item (1..1)
    set merged: items reduce a, b [ Merge(a, b) ]
