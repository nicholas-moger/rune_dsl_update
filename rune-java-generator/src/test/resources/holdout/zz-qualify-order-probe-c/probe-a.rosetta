namespace test.prb.qa
version "0.0.0"
isProduct root PrbTerms;

type PrbTerms: <"The qualifiable root type of test.prb.qa.">
    kind string (0..1)

func Qualify_PrbQA: <"Product qualification of test.prb.qa.">
    [qualification Product]
    inputs:
        terms PrbTerms (1..1)
    output:
        is_product boolean (1..1)
    set is_product:
        terms -> kind = "qa"
