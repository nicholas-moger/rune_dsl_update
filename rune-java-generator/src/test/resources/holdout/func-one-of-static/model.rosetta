namespace test.foneof024

type A:
    a1 string (0..1)
    a2 string (0..1)
    a3 boolean (0..1)

type B extends A:
    b1 string (0..1)

func TestOnlyExists:
	inputs:
		a A (1..1)
	output:
		result boolean (1..1)
	
	set result:
		a -> a1 only exists

func TestOneOf:
	inputs:
		a A (1..1)
	output:
		result boolean (1..1)
	
	set result:
		a one-of
