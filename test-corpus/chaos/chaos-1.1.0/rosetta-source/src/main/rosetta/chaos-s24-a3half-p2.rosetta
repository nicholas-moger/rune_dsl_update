namespace chaos.s24.a3half.p2
version "1.0.0"
import chaos.s24.a3half.p1.*
func C24Pass: <"The callee with a Void input and output.">
    inputs:
        t c24tok (0..1)
    output:
        u c24tok (0..1)
    set u: t
func C24Compare: <"Void operands of an equality, an inequality and a logical - the coercion seats no oracle group pins (the render law declines to today's bytes there).">
    inputs:
        c C24Carrier (1..1)
        d C24Carrier (1..1)
    output:
        r boolean (1..1)
    set r:
        c -> tok = d -> tok
        or c -> tok <> d -> tok
        or (c -> tok exists and d -> tok is absent)
func C24Arg: <"A Void value as a call ARGUMENT, in a list literal, under default, and in a switch arm.">
    inputs:
        c C24Carrier (1..1)
        d C24Carrier (1..1)
        k string (1..1)
    output:
        r c24tok (0..1)
    alias viaCall: C24Pass(c -> tok)
    alias listed: [c -> tok, d -> tok] first
    alias defaulted: c -> tok default d -> tok
    set r:
        k switch
            "a" then viaCall,
            "b" then listed,
            default defaulted
func C24Multi: <"multiple exists and single exists over a Void list, and a multi Void segment SET later mutated by ADD (the render law's unwitnessed multi arms).">
    inputs:
        c C24Carrier (1..1)
    output:
        out C24Out (1..1)
    condition C24Many:
        c -> toks multiple exists or c -> toks single exists or c -> toks is absent
    set out -> vs: c -> toks
    add out -> vs: c -> tok
func C24Segments: <"Void CONDITIONAL values into a META segment leaf, a MULTI segment leaf, a plain leaf and a two-hop segment leaf (seat 9 round 3's banked sub-shapes), and an as-key conditional at a reference leaf.">
    inputs:
        flag boolean (1..1)
        c C24Carrier (0..1)
        d C24Carrier (0..1)
        k C24Keyed (0..1)
    output:
        out C24Out (1..1)
    set out -> vm: if flag then c -> tok else d -> tok
    set out -> vs: if flag then c -> toks else d -> toks
    set out -> v: if flag then c -> tok else d -> tok
    set out -> car -> tok: if flag then c -> tok else d -> tok
    set out -> kref: (if flag then k else empty) as-key
    set out -> s: if flag then c -> name else "n"
reporting rule C24Tok from C24Carrier: <"A RULE's operation over a Void attribute (the rule Void-OUTPUT arm is a different law - banked at #630).">
    extract tok
        as "Void Token"
reporting rule C24TokPresence from C24Carrier: <"A Void attribute under exists inside a rule's conditional.">
    extract if tok exists then name else "absent"
        as "Void Presence"
