namespace chaos.s05.a3third.p2
version "1.0.0"
import chaos.s05.a3third.p1.*
import chaos.s05.a3third.p3.*
func C5Chain: <"then-chain over a list-of-list with implicit-LHS navigation at every hop.">
    inputs:
        items C5Item (0..*)
    output:
        total number (1..1)
    set total:
        items
            then extract sub
            then flatten
            then extract vals
            then flatten
            then filter item >= 0
            then sum
func C5Deep: <"Nested explicit-lambda extract, depth 3, with postfix chains inside.">
    inputs:
        items C5Item (0..*)
    output:
        names string (0..*)
    add names:
        items
            then extract x [
                x -> sub extract y [
                    y -> name + "-" + (y -> vals count to-string)
                ]
            ]
            then flatten
