namespace chaos.s18.a3third.p1
version "1.0.0"
import chaos.s18.a3third.p2.*
import chaos.s18.a3third.p3.*
type C18Sub: <"Self-contained helper - relocated by the import axis.">
    s string (1..1)
enum C18KindEnum: <"Enum-guard subject.">
    Red
    Green
    Blue
type C18OptA: <"Choice-guard option A.">
    av string (1..1)
type C18OptB: <"Choice-guard option B.">
    bv number (1..1)
choice C18Either: <"Choice-guard subject.">
    C18OptA
    C18OptB
func C18Colour: <"Enum guards with default.">
    inputs:
        k C18KindEnum (1..1)
    output:
        hex string (1..1)
    set hex:
        k switch
            Red then "ff0000",
            Green then "00ff00",
            default "0000ff"
