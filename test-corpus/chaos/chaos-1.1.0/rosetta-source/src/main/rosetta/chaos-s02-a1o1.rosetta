namespace chaos.s02.a1o1
version "1.0.0"
type C2Tag: <"Helper the import-style axis relocates.">
    tagLine string (1..1)
func C2Flip: <"Enum in function seats - compare, if/else, literal result.">
    inputs:
        d C2DirEnum (1..1)
    output:
        r C2DirEnum (1..1)
    set r:
        if d = C2DirEnum -> Buy
        then C2DirEnum -> Sell
        else if d = C2DirEnum -> Sell
        then C2DirEnum -> Buy
        else C2DirEnum -> Hold

type C2Use: <"Enum-typed attributes and enum-literal conditions.">
    dir C2DirEnum (1..1)
    exts C2ExtEnum (0..*)
    tags C2Tag (0..*)
    condition C2NotHold:
        dir <> C2DirEnum -> Hold
    condition C2HasAlpha:
        if exts exists
        then exts contains C2ExtEnum -> Alpha or exts contains C2ExtEnum -> Gamma
enum C2BaseEnum: <"Extension base.">
    Alpha
    Beta displayName "B"
enum C2ExtEnum extends C2BaseEnum: <"Extends across a block boundary.">
    Gamma displayName "G3" <"Third letter.">
enum C2DirEnum: <"Directions with displayName and docs.">
    Buy displayName "BUY" <"Buy side.">
    Sell displayName "SELL"
    Hold <"No action.">
