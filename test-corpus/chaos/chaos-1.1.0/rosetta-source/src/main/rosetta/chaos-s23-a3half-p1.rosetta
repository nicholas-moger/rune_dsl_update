namespace chaos.s23.a3half.p1
version "1.0.0"
import chaos.s23.a3half.p2.*
type C23Box: <"Helper - relocated by the import axis.">
    lid string (1..1)
    weight number (0..1)
    live boolean (0..1)
func C23IsBig: <"Boolean helper (the bare-call condition class).">
    inputs:
        v number (1..1)
    output:
        big boolean (1..1)
    set big: v > 1000000
func C23WholeSet: <"A beyond-long literal as the WHOLE value of a MULTI output, a defaulted number, and an int list literal ADDED to a number list - the whole-SET / ADD conversion seats the 1.0.0 C4Gate rows never carried (seat 5's partial-coverage banking).">
    inputs:
        b C23Box (1..1)
    output:
        rs number (0..*)
    add rs: 9999999999999999999999999
    add rs: b -> weight default 0
    add rs: [1, 2, 3]
func C23IntOut: <"An int output takes the exact conversion (the int-output seat).">
    inputs:
        v number (1..1)
    output:
        r int (1..1)
    set r:
        if C23IsBig(v)
        then 9999999999999999999999999
        else 1
typeAlias C23Long: <"The Long rung of the alias digit law - a 10-to-18-digit literal alias declares MapperS<Long> upstream (seat 5's banked conv-bigint-alias-long).">
    int(digits: 18)
func C23LongAlias: <"A 12-digit literal through an alias at a then arm and into a Long-aliased output.">
    inputs:
        v number (1..1)
        f boolean (1..1)
    output:
        r number (1..1)
    alias big12: 123456789012
    set r:
        if f
        then big12
        else v
func C23LongOut: <"The 12-digit literal into the Long-aliased output.">
    inputs:
        f boolean (1..1)
    output:
        r C23Long (0..1)
    set r: if f then 123456789012 else 42
func C23AliasElse: <"The conversion renderer's case (ii): a null-typed ALIAS call at an ELSE arm (seat 5's banked conv-bigint-alias-else).">
    inputs:
        v number (1..1)
        f boolean (1..1)
    output:
        r number (1..1)
    alias huge: 9999999999999999999999999
    set r:
        if f
        then v
        else huge
