namespace chaos.s21.a3third.p2
version "1.0.0"
import chaos.s21.a3third.p1.*
import chaos.s21.a3third.p3.*
type C21Prefer: <"required and optional choice conditions side by side.">
    x string (0..1)
    y string (0..1)
    z string (0..1)
    aux C21Aux (0..1)
    condition C21Req:
        required choice x, y
    condition C21Opt:
        optional choice y, z
type C21Paths: <"only-exists targets.">
    p string (0..1)
    q string (0..1)
    r string (0..1)
func C21Gate: <"only exists - single path, list form, and inside if/else arms.">
    inputs:
        t C21Paths (1..1)
    output:
        ok boolean (1..1)
    set ok:
        if t -> p only exists
        then True
        else (t -> q, t -> r) only exists
