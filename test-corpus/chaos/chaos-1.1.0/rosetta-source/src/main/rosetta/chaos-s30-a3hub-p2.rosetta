namespace chaos.s30.a3hub.p2
version "1.0.0"
import chaos.s30.a3hub.p1.*
metaType key string
metaType reference string
metaType scheme string
type C30Whole: <"The ctor / set target: plain, meta, reference and nested seats.">
    name string (1..1)
    code string (0..1)
        [metadata scheme]
    scores number (0..*)
    part C30Part (0..1)
    partRef C30Part (0..1)
        [metadata reference]
    parts C30Part (0..*)
    nested C30Whole (0..1)
func C30TwoOp: <"The two-op pathed-SET pattern (seat 9's witness shape) with a with-meta ctor field, a two-hop as-key segment set and a scheme leaf set from a conditional.">
    inputs:
        p C30Part (1..1)
        flag boolean (1..1)
        a string (0..1)
    output:
        w C30Whole (1..1)
    set w: C30Whole { name: "root", code: "c" with-meta { scheme: "chaos" }, ... }
    set w -> nested -> partRef: p as-key
    set w -> nested -> name: if flag then "n" else "m"
    set w -> code: if a exists then a else "z"
func C30MultiThenAdd: <"A multi SET later mutated by ADD, twice-added list literals of DATA ctors, and an ADD of a conditional into a segment.">
    inputs:
        n number (1..1)
        p C30Part (1..1)
    output:
        w C30Whole (1..1)
    set w -> scores: [n]
    add w -> scores: n * 2
    add w -> scores: if n > 0 then [n, n + 1] else [0]
    set w -> parts: [p, C30Part { pid: "a" }]
    add w -> parts: [C30Part { pid: "b" }, C30Part { pid: "c" }]
    add w -> parts: if n > 1 then p else empty
    set w -> name: "x"
func C30Builders: <"A builder-typed multi output (a list of DATA) set whole from a lambda then added, and an empty reference leaf.">
    inputs:
        ps C30Part (0..*)
        p C30Part (0..1)
    output:
        ws C30Whole (0..*)
    set ws: ps extract x [ C30Whole { name: x -> pid, ... } ]
    add ws: C30Whole { name: "tail", partRef: p as-key, ... }
    add ws: C30Whole { name: "empty", partRef: empty, ... }
