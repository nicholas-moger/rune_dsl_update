namespace chaos.s14.a3half.p2
version "1.0.0"
import chaos.s14.a3half.p1.*
segment c14article
segment c14paragraph
segment c14annex
segment rationale
type C14Clause: <"docReference AND regulatoryReference at type and attribute level, incl. for-path and rationale_author.">
    [docReference C14REG C14Act c14article "3" provision "Type-level provision text."]
    [docReference for cid C14REG C14Act c14article "9" provision "For-path provision."]
    [regulatoryReference C14REG C14Act c14article "12"
        rationale_author "chaos"
        rationale "Because the census said the corpus writes this in 311 files and no seed did."
        provision "Regulatory-reference provision."]
    cid string (1..1)
        [docReference C14REG C14Act c14article "3" c14paragraph "1a" provision "Attribute-level provision."]
    weight number (0..1)
        [docReference C14ORG C14Guide c14annex "B" rationale "Because chaos." provision "Weighted per annex B."]
    aux C14Aux (0..1)
