/* chaos a9: a block-comment banner before the first token */
// chaos a9: a line comment before namespace
namespace chaos.s28.a9comment // a9
version "1.0.0" // a9
isEvent root C28Event; // a9
type C28Extra: <"Helper - relocated by the import axis."> // a9
    memo string (1..1) // a9
type C28Event: <"The qualifiable EVENT root - the A7 order-of-load race runs on the Event kind so the s22 Product race stays unmoved."> // a9
    kind string (0..1) // a9
    size number (0..1) // a9
    extra C28Extra (0..1) // a9
func Qualify_C28Trade: <"Event qualification 1."> // a9
    [qualification BusinessEvent] // a9
    inputs: // a9
        event C28Event (1..1) // a9
    output: // a9
        is_event boolean (1..1) // a9
    set is_event: // a9
        event -> kind = "trade" // a9
func Qualify_C28Cancel: <"Event qualification 2 - the overlapping predicate space."> // a9
    [qualification BusinessEvent] // a9
    inputs: // a9
        event C28Event (1..1) // a9
    output: // a9
        is_event boolean (1..1) // a9
    set is_event: // a9
        event -> kind = "cancel" and event -> size exists // a9
