namespace chaos.s08.a3half.p2
version "1.0.0"
import chaos.s08.a3half.p1.*
type C8Priced: <"Alias-typed attributes at every cardinality.">
    qty C8Positive (1..1)
    ccy C8Code (0..1)
    weights C8Pct (0..*)
    evens C8Even (0..*)
    box C8Box (0..1)
    condition C8WeightCap:
        if weights exists
        then weights sum <= 300
func C8Scale: <"Alias types crossing a function boundary.">
    inputs:
        q C8Positive (1..1)
        w C8Pct (1..1)
    output:
        r number (1..1)
    set r: q * w / 100
