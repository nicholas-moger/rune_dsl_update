namespace chaos.s05.a3third.p1
version "1.0.0"
import chaos.s05.a3third.p2.*
import chaos.s05.a3third.p3.*
type C5Sub: <"List-of-list rung and reference target - relocated by the import axis.">
    [metadata key]
    vals number (0..*)
    name string (1..1)
metaType key string
metaType reference string
enum C5KindEnum: <"to-enum target.">
    Spot
    Fwd
type C5Item: <"The shape battery: single, optional, multi, list-of-list rung, and a meta-wrapped seat (charter 2.2b).">
    one string (1..1)
    opt number (0..1)
    many number (0..*)
    sub C5Sub (0..*)
    subRef C5Sub (0..1)
        [metadata reference]
func C5Seats: <"The SAME construct (if-exists-then-else-0) at the alias, condition, and set seats.">
    inputs:
        it C5Item (1..1)
    output:
        r number (1..1)
    alias seatAlias: if it -> opt exists then it -> opt else 0
    condition SeatCond:
        (if it -> opt exists then it -> opt else 0) >= 0
    set r: (if it -> opt exists then it -> opt else 0) + seatAlias
