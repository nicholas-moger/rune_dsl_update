namespace chaos.s03.a3third.p2
version "1.0.0"
import chaos.s03.a3third.p1.*
import chaos.s03.a3third.p3.*
type C3Wrap: <"Wraps the inner choice; shares 'text' with C3Note.">
    inner C3Inner (1..1)
    text string (0..1)
choice C3Outer: <"Nested choice - an option that itself wraps a choice.">
    C3Wrap
    C3Note
