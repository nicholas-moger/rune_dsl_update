namespace chaos.s01.a2dangle
version "1.0.0"
import chaos.s01.a2dangle.h.*
import chaos.s01.a2dangle.unused.*
type C1Base: <"Root of the S01 inheritance chain.">
    baseId string (1..1)
    note string (0..1)
type C1Mid extends C1Base: <"Middle of the chain - adds a list and a date.">
    mids number (0..*)
    asOf date (0..1)
type C1Leaf extends C1Mid: <"Leaf - overrides, parameterised types, multi-cardinality.">
    override note string (1..1)
    parts C1Ref (2..*)
    ratio number(min: 0, max: 100) (0..1)
    code string(minLength: 3, maxLength: 3) (0..1)
type C1Cond: <"Type-level condition seats.">
    lo number (0..1)
    hi number (0..1)
    condition C1Bounds: <"Ordered when both present.">
        if lo exists and hi exists
        then lo <= hi
    condition:
        lo exists or hi exists
func C1Widen: <"Conditional arms of SIBLING SUBTYPES - the common-supertype/wildcard decl class (v3.1 F9).">
    inputs:
        b boolean (1..1)
        m C1Mid (1..1)
        l C1Leaf (1..1)
    output:
        out C1Base (1..1)
    set out:
        if b then l else m
type C1Times: <"Every temporal record type at every cardinality form.">
    d date (0..1)
    t time (0..1)
    dt dateTime (0..1)
    z zonedDateTime (0..1)
    ds date (0..*)
    stamp dateTime (1..1)
