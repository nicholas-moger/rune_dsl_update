namespace chaos.s34.a1o1
version "1.0.0"
type C34Aux: <"Helper - relocated by the import axis.">
    aux string (1..1)
enum C34Flag: <"An annotated enum.">
    [c34owner live]
    On
    Off

func C34Stage_Tag: <"Annotated function with two references - named under the prefix annotation's own contract (C34Stage_ - the oracle warns otherwise).">
    [c34owner team]
    [c34stage kind]
    inputs:
        s string (1..1)
    output:
        t string (1..1)
    set t: s + "!"
func C34Impl: <"A codeImplementation function (no body) beside a caller.">
    [codeImplementation]
    inputs:
        s string (1..1)
    output:
        t string (1..1)
func C34Caller: <"Calls the code-implemented function.">
    inputs:
        s string (1..1)
    output:
        t string (1..1)
    set t: C34Impl(s)
enum C34KindEnum: <"The annotation attribute's enum.">
    Alpha
    Beta
annotation c34owner: <"Annotation with string, number and boolean attributes.">
    team string (0..1)
    tier number (0..1)
    live boolean (0..1)
annotation c34stage: <"Annotation with a prefix and an enum-typed attribute.">
    [prefix C34Stage]
    kind C34KindEnum (0..1)
type C34Marked: <"Annotated type and attribute - bare, attribute-selecting and prefixed references.">
    [c34owner team]
    [c34stage kind]
    mid string (1..1)
        [c34owner tier]
    aux C34Aux (0..1)
