namespace chaos.s06.a2alias
version "1.0.0"
import chaos.s06.a2alias.h.* as C6TagNs
import chaos.s06.a2alias.h.C6Tag
metaType scheme string
type C6Event: <"The rule-from type; references the helper; carries a meta seat for the rule x meta conjunction.">
    eventId string (1..1)
    qty number (0..1)
    legs string (0..*)
    mark C6Tag (0..1)
    venue string (0..1)
        [metadata scheme]
func C6MarkOf: <"Function whose call result is NAVIGATED inside a rule arm (v3.1 F25).">
    inputs:
        ev C6Event (1..1)
    output:
        t C6Tag (0..1)
    set t: ev -> mark
eligibility rule C6IsReportable from C6Event: <"Eligibility seat.">
    qty exists and qty > 0
reporting rule C6Id from C6Event: <"Bare-attribute extract in a rule body.">
    extract eventId
        as "Event ID"
reporting rule C6Qty from C6Event: <"Conditional arithmetic in a rule body.">
    extract if qty exists then qty * 1 else 0
        as "Quantity"
reporting rule C6Legs from C6Event: <"then-chain + implicit-LHS filter inside a rule.">
    extract legs
        then filter item <> ""
        then join ";"
        as "Leg List"
reporting rule C6First from C6Event: <"Rule calling into list postfixes.">
    extract legs first default "none"
        as "First Leg"
reporting rule C6Venue from C6Event: <"A rule whose extracted value is META-annotated while the reported value is bare (v3.1 F1).">
    extract venue
        as "Venue Code"
reporting rule C6Compose from C6Event: <"A rule EXTRACTING ANOTHER RULE - the rule-call meta/cardinality typing class (v3.1 F6/F22).">
    extract C6Id
        then extract item + "-composed"
        as "Composed ID"
reporting rule C6NavCall from C6Event: <"A function call navigated inside a rule's conditional arm (v3.1 F25).">
    extract
        if qty exists
        then C6MarkOf(item) -> caption default "untagged"
        else "no-qty"
        as "Mark Caption"
