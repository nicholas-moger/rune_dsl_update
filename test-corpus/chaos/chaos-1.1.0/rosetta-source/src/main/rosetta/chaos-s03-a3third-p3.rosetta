namespace chaos.s03.a3third.p3
version "1.0.0"
import chaos.s03.a3third.p1.*
import chaos.s03.a3third.p2.*
type C3Deep: <"Navigates the common attribute across choice options.">
    pick C3Outer (0..1)
    picks C3Inner (0..*)
    condition C3TextWhenPicked:
        if pick exists
        then pick ->> text exists
    condition C3CommonNav:
        if picks exists
        then (picks ->> common) count <= picks count
func C3Commons: <"Deep-feature (->>) on the IMPLICIT item inside a lambda (v3.1 F16).">
    inputs:
        outers C3Outer (0..*)
    output:
        texts string (0..*)
    add texts:
        outers extract item ->> text
