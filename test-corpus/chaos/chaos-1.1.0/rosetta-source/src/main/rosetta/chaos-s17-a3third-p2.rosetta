namespace chaos.s17.a3third.p2
version "1.0.0"
import chaos.s17.a3third.p1.*
import chaos.s17.a3third.p3.*
func C17Which: <"Bare enum-value switch guards - the resolver must pick the input's enum, not a rival.">
    inputs:
        s C17SideEnum (1..1)
    output:
        r string (1..1)
    set r:
        s switch
            Buy then "side-buy",
            Sell then "side-sell"
func C17Act: <"Qualified enum-literal compares beside the bare-guard seat.">
    inputs:
        a C17ActionEnum (1..1)
    output:
        ok boolean (1..1)
    set ok: a = C17ActionEnum -> Buy or a = C17ActionEnum -> Amend
