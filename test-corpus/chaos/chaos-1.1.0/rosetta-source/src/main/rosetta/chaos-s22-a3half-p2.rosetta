namespace chaos.s22.a3half.p2
version "1.0.0"
import chaos.s22.a3half.p1.*
isProduct root C22Terms;
func Qualify_C22Vanilla: <"Product qualification against the declared root.">
    [qualification Product]
    inputs:
        c22terms C22Terms (1..1)
    output:
        is_product boolean (1..1)
    set is_product:
        c22terms -> kind = "vanilla" and c22terms -> notional exists
func Qualify_C22Exotic: <"Second qualifier - overlapping predicate space.">
    [qualification Product]
    inputs:
        c22terms C22Terms (1..1)
    output:
        is_product boolean (1..1)
    set is_product:
        c22terms -> kind <> "vanilla" or c22terms -> notional is absent
