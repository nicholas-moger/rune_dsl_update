namespace chaos.s02.a3third.p3
version "1.0.0"
import chaos.s02.a3third.p1.*
import chaos.s02.a3third.p2.*
func C2Flip: <"Enum in function seats - compare, if/else, literal result.">
    inputs:
        d C2DirEnum (1..1)
    output:
        r C2DirEnum (1..1)
    set r:
        if d = C2DirEnum -> Buy
        then C2DirEnum -> Sell
        else if d = C2DirEnum -> Sell
        then C2DirEnum -> Buy
        else C2DirEnum -> Hold
