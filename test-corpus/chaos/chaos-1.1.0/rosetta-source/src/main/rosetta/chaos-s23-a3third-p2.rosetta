namespace chaos.s23.a3third.p2
version "1.0.0"
import chaos.s23.a3third.p1.*
import chaos.s23.a3third.p3.*
typeAlias C23Long: <"The Long rung of the alias digit law - a 10-to-18-digit literal alias declares MapperS<Long> upstream (seat 5's banked conv-bigint-alias-long).">
    int(digits: 18)
func C23LongAlias: <"A 12-digit literal through an alias at a then arm and into a Long-aliased output.">
    inputs:
        v number (1..1)
        f boolean (1..1)
    output:
        r number (1..1)
    alias big12: 123456789012
    set r:
        if f
        then big12
        else v
func C23LongOut: <"The 12-digit literal into the Long-aliased output.">
    inputs:
        f boolean (1..1)
    output:
        r C23Long (0..1)
    set r: if f then 123456789012 else 42
func C23AliasElse: <"The conversion renderer's case (ii): a null-typed ALIAS call at an ELSE arm (seat 5's banked conv-bigint-alias-else).">
    inputs:
        v number (1..1)
        f boolean (1..1)
    output:
        r number (1..1)
    alias huge: 9999999999999999999999999
    set r:
        if f
        then v
        else huge
func C23Mul: <"The callee: number inputs, the int argument coerced at the call.">
    inputs:
        a number (1..1)
        b number (1..1)
    output:
        p number (1..1)
    set p: a * b
func C23Scale: <"An int INPUT in BigDecimal arithmetic at ARGUMENT position (F2's C8Scale class re-shaped: the argument seat), a count inside a lambda into a number output, and an int sum into a number.">
    inputs:
        q int (1..1)
        w number (1..1)
        bs C23Box (0..*)
    output:
        r number (1..1)
    alias scaled: C23Mul(q, w)
    alias counted: bs extract b [ b -> lid ] then count
    alias summed: bs extract b [ (b -> lid) count ] then sum
    set r: scaled + counted + summed + q
