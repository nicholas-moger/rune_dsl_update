namespace chaos.s13.base
version "1.0.0"
type C13Aux: <"Self-contained helper - relocated by the import axis.">
    ax string (1..1)
type C13Fact: <"Rule-source subject type.">
    fid string (1..1)
    amt number (0..1)
    aux C13Aux (0..1)
reporting rule C13Fid from C13Fact: <"The externally-attached rule.">
    extract fid
        as "Fact ID"
reporting rule C13Amt from C13Fact: <"Second externally-attached rule.">
    extract amt default 0
        as "Amount"
rule source C13Bare
{
}
rule source C13Attached extends C13Bare
{
    C13Fact:
        + fid
            [ruleReference C13Fid]
        + amt
            [ruleReference C13Amt]
}
