namespace chaos.s20.a3third.p2
version "1.0.0"
import chaos.s20.a3third.p1.*
import chaos.s20.a3third.p3.*
func C20Harvest: <"Nested extract to depth 4 with explicit lambdas at every level.">
    inputs:
        trunks C20Trunk (0..*)
    output:
        vs number (0..*)
    add vs:
        trunks
            then extract t [
                t -> branches extract b [
                    b -> twigs extract w [
                        w -> leaves extract l [ l -> v ]
                    ]
                ]
            ]
            then flatten
func C20Pipeline: <"An eight-step then-chain mixing filter, extract, distinct, sort, and reduce.">
    inputs:
        trunks C20Trunk (0..*)
    output:
        total number (1..1)
    set total:
        trunks
            then extract branches
            then flatten
            then extract twigs
            then flatten
            then extract leaves
            then flatten
            then extract v
            then filter item >= 0
            then distinct
            then sort
            then reduce a, b [ a + b ]
