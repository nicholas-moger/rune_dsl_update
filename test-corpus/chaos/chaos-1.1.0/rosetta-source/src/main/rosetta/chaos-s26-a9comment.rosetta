/* chaos a9: a block-comment banner before the first token */
// chaos a9: a line comment before namespace
namespace chaos.s26.a9comment // a9
version "1.0.0" // a9
type C26Tag: <"Helper - relocated by the import axis."> // a9
    code string (1..1) // a9
enum C26KindEnum: <"Enum-guard subject."> // a9
    Red // a9
    Green // a9
    Blue // a9
func C26Lit: <"Number and boolean literal ARMS and DEFAULTS under literal guards in a lambda-item switch (seat 7's banked kinds beyond string and int)."> // a9
    inputs: // a9
        raws string (0..*) // a9
    output: // a9
        n number (1..1) // a9
    alias nums: raws extract (item switch "a" then 1.5, "b" then 2.25, default 0.5) // a9
    alias flags: raws extract (item switch "a" then True, "b" then False, default False) // a9
    set n: (nums then sum) + (flags then filter item = True then count) // a9
