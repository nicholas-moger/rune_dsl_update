namespace chaos.s21.a3third.p3
version "1.0.0"
import chaos.s21.a3third.p1.*
import chaos.s21.a3third.p2.*
func C21Void: <"is absent + exists modifiers at condition seats.">
    inputs:
        t C21Paths (1..1)
        many string (0..*)
    output:
        n number (1..1)
    condition C21NoP:
        t -> p is absent or t -> p exists
    condition C21Card:
        many multiple exists or many single exists or many is absent
    set n: many count
