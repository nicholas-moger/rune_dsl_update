namespace chaos.s20.a3half.p1
version "1.0.0"
import chaos.s20.a3half.p2.*
type C20Leaf: <"Depth-4 leaf - relocated by the import axis.">
    v number (1..1)
type C20Twig: <"Depth 3.">
    leaves C20Leaf (0..*)
type C20Branch: <"Depth 2.">
    twigs C20Twig (0..*)
type C20Trunk: <"Depth 1.">
    branches C20Branch (0..*)
    title string (1..1)
func C20Harvest: <"Nested extract to depth 4 with explicit lambdas at every level.">
    inputs:
        trunks C20Trunk (0..*)
    output:
        vs number (0..*)
    add vs:
        trunks
            then extract t [
                t -> branches extract b [
                    b -> twigs extract w [
                        w -> leaves extract l [ l -> v ]
                    ]
                ]
            ]
            then flatten
