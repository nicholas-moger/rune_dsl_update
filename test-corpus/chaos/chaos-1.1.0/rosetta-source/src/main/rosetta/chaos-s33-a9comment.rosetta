version "1.0.0" // a9
type C33Extra: <"Helper - relocated by the import axis."> // a9
    memo string (1..1) // a9
synonym source C33Src // a9
body Authority C33AUTH <"Authority with a quote: \"quoted\", a backslash \\ and µ–ü."> // a9
corpus Regulation "C33 “Chaos” Règlement \"quoted\" \\ back" C33Reg <"Display string with non-ASCII, a quote and a backslash."> // a9
segment c33article // a9
type C33Trade: <"Labels, synonyms and docReferences carrying non-ASCII, a quote and a backslash each (D46's REACH beyond the enum seats)."> // a9
