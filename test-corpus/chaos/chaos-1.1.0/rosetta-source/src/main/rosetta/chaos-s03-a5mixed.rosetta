namespace chaos.s03.a5mixed
version "1.0.0"
type C3Note: <"Choice option AND helper - relocated by the import axis.">
    text string (1..1)
type C3CashLeg: <"Option 1 - shares 'common' with its sibling.">
    ccy string (1..1)
    common string (0..1)
type C3StockLeg: <"Option 2.">
    ticker string (1..1)
    common string (0..1)
choice C3Inner: <"Inner choice - the findCommonAttribute surface.">
    C3CashLeg
    C3StockLeg
